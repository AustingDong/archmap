{
  "permissions": {
    "allow": [
      "Bash(conda run:*)",
      "Bash(python:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(ls:*)",
      "Bash(pip install:*)",
      "mcp__archmap__orient",
      "mcp__archmap__get_task",
      "mcp__archmap__report",
      "WebSearch"
    ]
  },
  "enabledMcpjsonServers": [
    "archmap"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/context_inject.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/snapshot_update.py"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
